# Shuffle configuration: NON-secret values only (committed).
# Secrets (OpenSearch password, encryption modifier) are generated by
# shuffle.sh into secrets/shuffle-secrets.env (git-ignored).
# Derived from upstream-v2.3.0/.env. Only lab-relevant keys kept or changed.

ENVIRONMENT_NAME=Shuffle
LIQUID_SANITIZE_INPUT=true

# Empty: do NOT clone the whole app library from GitHub at startup (hours on
# this network, ~200 apps). Only the apps vendored in soar/shuffle/apps/ are
# loaded (fetch-apps.sh, pinned commit), mounted read-only as the hotload folder.
SHUFFLE_APP_DOWNLOAD_LOCATION=
SHUFFLE_APP_FORCE_UPDATE=false

# Empty on purpose: the admin account is created by a person in the web UI on first visit.
SHUFFLE_DEFAULT_USERNAME=
SHUFFLE_DEFAULT_PASSWORD=
SHUFFLE_DEFAULT_APIKEY=

BASE_URL=http://shuffle-backend:5001
SSO_REDIRECT_URL=http://localhost:3001
BACKEND_HOSTNAME=shuffle-backend
BACKEND_PORT=5001
FRONTEND_PORT=3001
FRONTEND_PORT_HTTPS=3443
OUTER_HOSTNAME=shuffle-backend
DOCKER_API_VERSION=1.44

# Fixed address of shuffle-backend on the kind Docker network (172.24.0.0/16).
# Falcosidekick posts alerts to http://<this IP>:5001/api/v1/hooks/<webhook-id>
SHUFFLE_KIND_IP=172.24.255.10

SHUFFLE_PASS_WORKER_PROXY=TRUE
SHUFFLE_PASS_APP_PROXY=TRUE
SHUFFLE_INTERNAL_HTTP_PROXY=noproxy
SHUFFLE_INTERNAL_HTTPS_PROXY=noproxy

# UTC everywhere: evidence timestamps from Falco, Kubernetes and the SOAR must line up.
TZ=UTC

SHUFFLE_SKIPSSL_VERIFY=true
IS_KUBERNETES=false
SHUFFLE_BASE_IMAGE_REPOSITORY=frikky
# false: app images come from Docker Hub (frikky/shuffle:<app>_<version>),
# which is fast here, instead of ghcr.io, which is very slow on this network.
SHUFFLE_USE_GCHR_OVERRIDE_FOR_AUTODEPLOY=false
SHUFFLE_SWARM_BRIDGE_DEFAULT_INTERFACE=eth0
SHUFFLE_SWARM_BRIDGE_DEFAULT_MTU=1500

SHUFFLE_CONTAINER_AUTO_CLEANUP=true
SHUFFLE_ORBORUS_EXECUTION_CONCURRENCY=5
SHUFFLE_HEALTHCHECK_DISABLED=false
SHUFFLE_ELASTIC=true
SHUFFLE_LOGS_DISABLED=true
SHUFFLE_CHAT_DISABLED=true
SHUFFLE_DISABLE_RERUN_AND_ABORT=false
SHUFFLE_RERUN_SCHEDULE=300
SHUFFLE_APP_REPLICAS=1

DATASTORE_EMULATOR_HOST=shuffle-database:8000
SHUFFLE_OPENSEARCH_URL=https://shuffle-opensearch:9200
SHUFFLE_OPENSEARCH_SKIPSSL_VERIFY=true
SHUFFLE_OPENSEARCH_USERNAME=admin

SHUFFLE_PROTECTED_CLEANUP_DISABLED=true
DEBUG_MODE=false
